# Non-secret production settings. Copy to a host-only file outside the release tree.
# This example cannot activate providers or a production deployment by itself.
OMNIREACH_ENV=production
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=4100
ORAP_HOSTNAME=admin.omnireach.cloud
# Required before authentication activation: replace with the inventoried Caddy peer CIDR and,
# when Caddy preserves a verified Cloudflare chain, the approved Cloudflare proxy CIDRs.
TRUSTED_PROXY_CIDRS=
REPOSITORY_ROOT=/opt/omnireach
ASSET_STORAGE_ROOT=/var/lib/omnireach/assets
PREVIEW_STORAGE_ROOT=/var/lib/omnireach/previews
PUBLICATION_STORAGE_ROOT=/var/lib/omnireach/publications
# Database UUID returned by `npm run coop:onboard`; enables atomic active-artifact serving.
COOPS_SITE_ID=
JOB_QUEUE_PREFIX=omnireach
SCHEDULER_INTERVAL_MS=15000
SCHEDULER_CLAIM_LIMIT=25
WORKER_CONCURRENCY=1
WORKER_LEASE_MS=60000
WORKER_BULL_LOCK_MS=120000
CRAWLER_MAX_PAGES=100
CRAWLER_MAX_BYTES=2000000
CRAWLER_MAX_REDIRECTS=5
CRAWLER_TIMEOUT_MS=15000
OPENAI_PROVIDER_ENABLED=false
OPENAI_MODEL_SELECTION=content-review-balanced
OPENAI_MODEL_ALIASES_JSON={"content-review-balanced":"gpt-6.1-sol","content-review-economy":"gpt-6-luna"}
OPENAI_MAX_OUTPUT_TOKENS=800
GOOGLE_INTEGRATION_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backup credentials are consumed only by the separately scheduled backup command.
# Keep the access key, secret key, and encryption key in protected secret files/env.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=
R2_REGION=auto
R2_BACKUP_PREFIX=omnireach
BACKUP_OFFSITE_ENABLED=false
# Non-secret identifier for the active encryption-key generation. Increment on rotation.
BACKUP_KEY_VERSION=1
# Fail closed before a backup or provider listing can consume unbounded memory/requests.
BACKUP_MAX_FILES=100000
BACKUP_MAX_SOURCE_BYTES=536870912
BACKUP_MAX_ENCRYPTED_BYTES=536870912
BACKUP_MAX_ARCHIVE_BYTES=536870912
# Fail closed before the dedicated bucket prefix reaches 80% of R2's included
# Standard-storage allowance. This is a safety ceiling, not a billing guarantee.
BACKUP_R2_MAX_TOTAL_BYTES=8589934592
BACKUP_R2_MAX_REQUESTS=50
BACKUP_R2_MAX_LIST_PAGES=5
BACKUP_R2_MAX_LIST_OBJECTS=50
BACKUP_R2_MAX_LIST_RESPONSE_BYTES=1048576
OMNIREACH_PRODUCTION_ROOTS=/var/lib/omnireach:/var/backups/omnireach
# Comma-separated host:port/database identities; contains no password.
OMNIREACH_PRODUCTION_DATABASE_TARGETS=postgres:5432/omnireach
OPENAI_TIMEOUT_MS=30000
CONTACT_DELIVERY_ENABLED=false
PLATFORM_INQUIRY_ENABLED=false
AUTH_EMAIL_DELIVERY_ENABLED=false
ALERT_EMAIL_DELIVERY_ENABLED=false
RESEND_CONTACT_FROM=forms@updates.omnireach.cloud
RESEND_AUTH_FROM=auth@updates.omnireach.cloud
RESEND_ALERT_FROM=alerts@updates.omnireach.cloud
