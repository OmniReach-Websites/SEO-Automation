model MetricSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  siteId       String   @map("site_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  source       String   @db.VarChar(40)
  metric       String   @db.VarChar(100)
  dimensions   Json
  windowStart  DateTime @map("window_start") @db.Timestamptz(3)
  windowEnd    DateTime @map("window_end") @db.Timestamptz(3)
  value        Decimal  @db.Decimal(20, 6)
  sourceHash   String   @map("source_hash") @db.Char(64)
  ingestedAt   DateTime @map("ingested_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([connectionId, sourceHash])
  @@index([tenantId, siteId, metric, windowStart])
  @@map("metric_snapshots")
}

