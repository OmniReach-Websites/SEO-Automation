generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                       @id @default(uuid()) @db.Uuid
  normalizedEmail      String                       @unique @map("normalized_email") @db.VarChar(320)
  displayName          String                       @map("display_name") @db.VarChar(160)
  status               String                       @default("active") @db.VarChar(32)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships          Membership[]
  platformMembership   PlatformMembership?
  authenticationPolicy AccountAuthenticationPolicy?
  accountRecoveryCodes AccountRecoveryCode[]
  webAuthnScopes       WebAuthnScope[]

  @@map("users")
}

model PlatformMembership {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  role        String   @db.VarChar(64)
  active      Boolean  @default(true)
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([role, active])
  @@map("platform_memberships")
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(160)
  status      String       @default("active") @db.VarChar(32)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  sites       Site[]
  memberships Membership[]
  auditEvents AuditEvent[]

  @@map("tenants")
}

model Site {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  name                  String          @db.VarChar(160)
  status                String          @default("active") @db.VarChar(32)
  contractVersion       String?         @map("contract_version") @db.VarChar(32)
  contractHash          String?         @map("contract_hash") @db.VarChar(128)
  sourcePath            String?         @map("source_path") @db.VarChar(500)
  standardPageCount     Int             @default(1) @map("standard_page_count")
  businessLocationCount Int             @default(1) @map("business_location_count")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  domains               Domain[]
  memberships           Membership[]
  auditEvents           AuditEvent[]
  webAuthnScopes        WebAuthnScope[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("sites")
}

model Domain {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  siteId               String    @map("site_id") @db.Uuid
  hostname             String    @unique @db.VarChar(253)
  kind                 String    @db.VarChar(32)
  verificationStatus   String    @default("pending") @map("verification_status") @db.VarChar(32)
  onboardingState      String    @default("requested") @map("onboarding_state") @db.VarChar(32)
  provider             String?   @db.VarChar(32)
  providerZoneRef      String?   @map("provider_zone_ref") @db.VarChar(160)
  credentialRef        String?   @map("credential_ref") @db.VarChar(200)
  verificationEvidence Json?     @map("verification_evidence")
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz(3)
  tlsCheckedAt         DateTime? @map("tls_checked_at") @db.Timestamptz(3)
  retryCount           Int       @default(0) @map("retry_count")
  retryAfter           DateTime? @map("retry_after") @db.Timestamptz(3)
  lastErrorCode        String?   @map("last_error_code") @db.VarChar(100)
  active               Boolean   @default(false)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  site                 Site      @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, siteId])
  @@map("domains")
}

model DomainOperation {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  siteId             String   @map("site_id") @db.Uuid
  domainId           String   @map("domain_id") @db.Uuid
  actorId            String   @map("actor_id") @db.Uuid
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(160)
  operation          String   @db.VarChar(40)
  dryRun             Boolean  @map("dry_run")
  proposedChanges    Json     @map("proposed_changes")
  outcome            String   @db.VarChar(30)
  providerRequestRef String?  @map("provider_request_ref") @db.VarChar(160)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, siteId, idempotencyKey])
  @@index([tenantId, siteId, createdAt])
  @@map("domain_operations")
}

model Membership {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String   @db.VarChar(64)
  permissions Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  site        Site     @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, siteId, userId])
  @@index([userId, active])
  @@map("memberships")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  siteId     String?  @map("site_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(160)
  reason     String?  @db.VarChar(500)
  traceId    String   @map("trace_id") @db.VarChar(128)
  targetType String?  @map("target_type") @db.VarChar(80)
  targetId   String?  @map("target_id") @db.Uuid
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  site       Site?    @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, siteId, createdAt])
  @@index([traceId])
  @@map("audit_events")
}

model SchemaMetadata {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("schema_metadata")
}

model Credential {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  failedAttempts    Int       @default(0) @map("failed_attempts")
  blockedUntil      DateTime? @map("blocked_until") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("credentials")
}

model Session {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  tenantId                String?   @map("tenant_id") @db.Uuid
  siteId                  String?   @map("site_id") @db.Uuid
  host                    String    @db.VarChar(253)
  tokenHash               String    @unique @map("token_hash") @db.Char(64)
  rotatedFromId           String?   @map("rotated_from_id") @db.Uuid
  authenticationMethod    String    @default("password") @map("authentication_method") @db.VarChar(32)
  authenticationAssurance String    @default("basic") @map("authentication_assurance") @db.VarChar(16)
  verifiedAt              DateTime? @map("verified_at") @db.Timestamptz(3)
  recoveryRestricted      Boolean   @default(false) @map("recovery_restricted")
  expiresAt               DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt              DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt               DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason            String?   @map("revoke_reason") @db.VarChar(160)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@index([tenantId, siteId, expiresAt])
  @@map("sessions")
}

model PasswordRecoveryToken {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  host            String?   @db.VarChar(253)
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(3)
  requestedIpHash String?   @map("requested_ip_hash") @db.Char(64)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@map("password_recovery_tokens")
}

model PasswordRecoveryDeliveryOutbox {
  id                   String    @id @default(uuid()) @db.Uuid
  recoveryTokenId      String    @unique @map("recovery_token_id") @db.Uuid
  encryptedToken       Bytes?    @map("encrypted_token")
  encryptionKeyVersion Int       @default(1) @map("encryption_key_version")
  status               String    @default("queued") @db.VarChar(24)
  attempts             Int       @default(0)
  availableAt          DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz(3)
  lastErrorCode        String?   @map("last_error_code") @db.VarChar(64)
  deliveredAt          DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("password_recovery_delivery_outbox")
}

model MfaFactor {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  kind                 String                @db.VarChar(32)
  encryptedSecret      Bytes                 @map("encrypted_secret")
  keyVersion           Int                   @map("key_version")
  lastUsedCounter      BigInt?               @map("last_used_counter")
  verifiedAt           DateTime?             @map("verified_at") @db.Timestamptz(3)
  revokedAt            DateTime?             @map("revoked_at") @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  accountRecoveryCodes AccountRecoveryCode[]

  @@map("mfa_factors")
}

model MfaEncryptionKeyRetirement {
  keyVersion    Int      @id @map("key_version")
  changeId      String   @map("change_id") @db.VarChar(128)
  retiredAt     DateTime @default(now()) @map("retired_at") @db.Timestamptz(3)
  retiredByRole String   @default(dbgenerated("session_user")) @map("retired_by_role") @db.VarChar(63)

  @@map("mfa_encryption_key_retirements")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  factorId  String    @map("factor_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("mfa_recovery_codes")
}

model AccountAuthenticationPolicy {
  userId                String   @id @map("user_id") @db.Uuid
  authStateVersion      BigInt   @default(1) @map("auth_state_version")
  secondStepRequirement String   @default("optional") @map("second_step_requirement") @db.VarChar(16)
  emailCodeEnabled      Boolean  @default(false) @map("email_code_enabled")
  preferredMethod       String?  @map("preferred_method") @db.VarChar(32)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_authentication_policies")
}

model AccountRecoveryCode {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  setVersion     Int        @default(1) @map("set_version")
  codeHash       String     @unique @map("code_hash") @db.Char(64)
  sourceFactorId String?    @map("source_factor_id") @db.Uuid
  usedAt         DateTime?  @map("used_at") @db.Timestamptz(3)
  revokedAt      DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFactor   MfaFactor? @relation(fields: [sourceFactorId], references: [id], onDelete: SetNull)

  @@index([userId, setVersion, createdAt])
  @@index([sourceFactorId])
  @@map("account_recovery_codes")
}

model WebAuthnScope {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  tenantId    String?              @map("tenant_id") @db.Uuid
  siteId      String?              @map("site_id") @db.Uuid
  rpId        String               @map("rp_id") @db.VarChar(253)
  userHandle  Bytes                @map("user_handle")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  site        Site?                @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict)
  credentials WebAuthnCredential[]

  @@index([userId, rpId, tenantId, siteId])
  @@index([tenantId, siteId, rpId])
  @@map("webauthn_scopes")
}

model WebAuthnCredential {
  id             String        @id @default(uuid()) @db.Uuid
  scopeId        String        @map("scope_id") @db.Uuid
  credentialId   Bytes         @map("credential_id")
  publicKey      Bytes         @map("public_key")
  signCount      BigInt        @default(0) @map("sign_count")
  transports     String[]      @default([]) @db.VarChar(32)
  deviceType     String        @map("device_type") @db.VarChar(16)
  backupEligible Boolean       @map("backup_eligible")
  backedUp       Boolean       @map("backed_up")
  name           String        @db.VarChar(80)
  verifiedAt     DateTime      @map("verified_at") @db.Timestamptz(3)
  lastUsedAt     DateTime?     @map("last_used_at") @db.Timestamptz(3)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(3)
  revokeReason   String?       @map("revoke_reason") @db.VarChar(160)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  scope          WebAuthnScope @relation(fields: [scopeId], references: [id], onDelete: Restrict)

  @@unique([scopeId, credentialId])
  @@index([scopeId, createdAt])
  @@map("webauthn_credentials")
}

model OwnerBootstrap {
  singleton  Boolean   @id @default(true)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  consumedBy String?   @map("consumed_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("owner_bootstrap")
}

model CustomerInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  siteId          String    @map("site_id") @db.Uuid
  normalizedEmail String    @map("normalized_email") @db.VarChar(320)
  role            String    @db.VarChar(64)
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  invitedBy       String    @map("invited_by") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, siteId, expiresAt])
  @@map("customer_invitations")
}

model Plan {
  id                             String   @id @default(uuid()) @db.Uuid
  code                           String   @db.VarChar(80)
  name                           String   @db.VarChar(160)
  version                        Int
  active                         Boolean  @default(true)
  monthlyPriceCents              Int      @default(0) @map("monthly_price_cents")
  currency                       String   @default("USD") @db.Char(3)
  commercialStatus               String   @default("proposal") @map("commercial_status") @db.VarChar(20)
  customerSeatLimit              Int      @default(1) @map("customer_seat_limit")
  standardPageLimit              Int      @default(1) @map("standard_page_limit")
  businessLocationLimit          Int      @default(1) @map("business_location_limit")
  seoAuditIntervalHours          Int      @default(168) @map("seo_audit_interval_hours")
  aiReviewCyclesPerMonth         Int      @default(0) @map("ai_review_cycles_per_month")
  pendingInvitationsCountAsSeats Boolean  @default(true) @map("pending_invitations_count_as_seats")
  createdAt                      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([code, version])
  @@map("plans")
}

model FeatureDefinition {
  key          String   @db.VarChar(120)
  version      Int
  description  String
  overrideable Boolean  @default(true)
  safeDefault  Boolean  @default(false) @map("safe_default")
  readiness    String   @default("planned") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([key, version])
  @@map("feature_definitions")
}

model PlanFeature {
  planId         String  @map("plan_id") @db.Uuid
  featureKey     String  @map("feature_key") @db.VarChar(120)
  featureVersion Int     @map("feature_version")
  enabled        Boolean

  @@id([planId, featureKey])
  @@map("plan_features")
}

model Subscription {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  siteId      String    @unique @map("site_id") @db.Uuid
  planId      String    @map("plan_id") @db.Uuid
  status      String    @db.VarChar(30)
  graceEndsAt DateTime? @map("grace_ends_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, siteId])
  @@map("subscriptions")
}

model PlanQuotaUsage {
  tenantId    String   @map("tenant_id") @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  quotaKey    String   @map("quota_key") @db.VarChar(80)
  periodStart DateTime @map("period_start") @db.Date
  used        Int      @default(0)
  reserved    Int      @default(0)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, siteId, quotaKey, periodStart])
  @@map("plan_quota_usage")
}

model PlanQuotaReservation {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  siteId      String    @map("site_id") @db.Uuid
  quotaKey    String    @map("quota_key") @db.VarChar(80)
  periodStart DateTime  @map("period_start") @db.Date
  amount      Int
  state       String    @default("active") @db.VarChar(20)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finalizedAt DateTime? @map("finalized_at") @db.Timestamptz(3)

  @@index([tenantId, siteId, quotaKey, periodStart, expiresAt])
  @@map("plan_quota_reservations")
}

model SitePlanQuotaOverride {
  tenantId      String   @map("tenant_id") @db.Uuid
  siteId        String   @map("site_id") @db.Uuid
  quotaKey      String   @map("quota_key") @db.VarChar(80)
  quotaLimit    Int      @map("quota_limit")
  reason        String   @db.VarChar(500)
  actorId       String   @map("actor_id") @db.Uuid
  policyVersion Int      @map("policy_version")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, siteId, quotaKey])
  @@map("site_plan_quota_overrides")
}

model PlatformAiBudget {
  singleton       Boolean  @id @default(true)
  capUsdMicros    BigInt   @default(50000000) @map("cap_usd_micros")
  policyVersion   Int      @default(1) @map("policy_version")
  overrideReason  String?  @map("override_reason") @db.VarChar(500)
  overrideActorId String?  @map("override_actor_id") @db.Uuid
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("platform_ai_budget")
}

model PlatformAiBudgetPeriod {
  periodStart       DateTime @id @map("period_start") @db.Timestamptz(3)
  capUsdMicros      BigInt   @map("cap_usd_micros")
  reservedUsdMicros BigInt   @default(0) @map("reserved_usd_micros")
  usedUsdMicros     BigInt   @default(0) @map("used_usd_micros")
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("platform_ai_budget_periods")
}

model SiteFeatureOverride {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  featureKey     String   @map("feature_key") @db.VarChar(120)
  featureVersion Int      @map("feature_version")
  enabled        Boolean
  reason         String   @db.VarChar(500)
  actorId        String   @map("actor_id") @db.Uuid
  effectiveAt    DateTime @default(now()) @map("effective_at") @db.Timestamptz(3)
  policyVersion  Int      @map("policy_version")

  @@unique([siteId, featureKey])
  @@map("site_feature_overrides")
}

model SiteEmergencyControl {
  tenantId                 String   @map("tenant_id") @db.Uuid
  siteId                   String   @map("site_id") @db.Uuid
  editingFrozen            Boolean  @default(false) @map("editing_frozen")
  autonomousChangesStopped Boolean  @default(false) @map("autonomous_changes_stopped")
  automationStopped        Boolean  @default(false) @map("automation_stopped")
  reason                   String   @db.VarChar(500)
  actorId                  String   @map("actor_id") @db.Uuid
