# Copy to an ignored local file. Values below are intentionally empty or fictional.
# Never place real credentials, customer data, production domains, or provider tokens here.

OMNIREACH_ENV=local
LOG_LEVEL=info

# Fictional local-only defaults for infrastructure/compose/dev.compose.yml.
API_HOST=127.0.0.1
API_PORT=4100
ORAP_HOSTNAME=admin.omnireach.test
# Comma-separated exact proxy IPs/CIDRs. Leave empty locally. Production must include
# only the inventoried Caddy peer and any explicitly trusted upstream proxy ranges.
TRUSTED_PROXY_CIDRS=
DATABASE_URL=postgresql://omnireach_dev:local-development-only@127.0.0.1:54320/omnireach_dev
REDIS_URL=redis://127.0.0.1:56379
# Generate a unique local value with at least 32 random characters; never reuse it outside local development.
SESSION_SECRET=
# Generate a separate unique value with at least 32 random characters; never reuse the session secret.
MFA_ENCRYPTION_KEY=
# Generate another independent value for expiring preview URLs.
PREVIEW_SIGNING_KEY=
# Generate a 32-byte key as exactly 64 hexadecimal characters for encrypted local contact payloads.
CONTACT_ENCRYPTION_KEY=
# Cloudflare Turnstile widget/public key and server-only verification secret.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Verified commit SHA used in immutable build provenance (40 or 64 lowercase hex characters).
SOURCE_COMMIT_SHA=

# Server-only provider credentials. Leave empty for mock/local execution.
OPENAI_API_KEY=
OPENAI_PROVIDER_ENABLED=false
OPENAI_MODEL_SELECTION=content-review-balanced
OPENAI_MODEL_ALIASES_JSON={"content-review-balanced":"gpt-6.1-sol","content-review-economy":"gpt-6-luna"}
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TIMEOUT_MS=30000
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend production contact delivery. Keep disabled until the sender domain and recipients are verified.
RESEND_API_KEY=
RESEND_CONTACT_FROM=forms@updates.omnireach.cloud
CONTACT_DELIVERY_ENABLED=false
# Approved authentication sender; keep delivery disabled until domain verification.
RESEND_AUTH_FROM=auth@updates.omnireach.cloud
AUTH_EMAIL_DELIVERY_ENABLED=false
# Operational alert sender is approved; the private critical recipient remains owner-supplied.
RESEND_ALERT_FROM=alerts@updates.omnireach.cloud
ALERT_EMAIL_RECIPIENT=
ALERT_EMAIL_DELIVERY_ENABLED=false

# Local filesystem adapters; directories are ignored and must be site-isolated.
ASSET_STORAGE_ROOT=runtime-data/assets
PREVIEW_STORAGE_ROOT=runtime-data/previews
PUBLICATION_STORAGE_ROOT=runtime-data/publications
REPOSITORY_ROOT=.
BACKUP_STORAGE_ROOT=
BACKUP_ENCRYPTION_KEY=

# Reserved for the production Cloudflare R2 backup adapter. Use a separate
# least-privilege R2 token; do not broaden the DNS token's permissions.
R2_BUCKET_NAME=omnireach-production-backups
R2_API_TOKEN=
BACKUP_OFFSITE_ENABLED=false
