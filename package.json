{
  "name": "omnireach-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Agency-operated multi-tenant website and SEO/AIO platform",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.x",
    "npm": "11.19.x"
  },
  "workspaces": [
    "apps/*",
    "sites/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json --noEmit --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:contracts": "vitest run --config vitest.contracts.config.ts",
    "test:load": "vitest run --config vitest.load.config.ts",
    "check:docs": "node tooling/check-docs.mjs",
    "check:migrations": "node tooling/check-migrations.mjs",
    "check:compose": "node tooling/check-compose.mjs",
    "check:production-compose": "node tooling/check-production-compose.mjs",
    "check:workflows": "node tooling/check-workflows.mjs",
    "check:workspaces": "node tooling/check-workspaces.mjs",
    "check:site-builds": "node tooling/check-site-builds.mjs",
    "validate:sites": "node tooling/validate-sites.mjs",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:seed": "node --experimental-transform-types packages/database/src/seed.ts",
    "db:sync-orap-catalog": "node --experimental-transform-types tooling/sync-orap-authorization.ts",
    "db:create-owner-bootstrap": "node --experimental-transform-types packages/database/src/create-owner-bootstrap.ts",
    "coop:onboard": "node --experimental-transform-types --env-file-if-exists=.env.local tooling/coop-onboarding.ts --apply",
    "coop:diagnose": "node --experimental-transform-types --env-file-if-exists=.env.local tooling/coop-onboarding.ts --check-dns",
    "auth:rotate-mfa-key": "node --experimental-transform-types --env-file-if-exists=.env.local tooling/rotate-mfa-encryption.ts",
    "publisher:run-request": "node --experimental-transform-types --env-file-if-exists=.env.local workers/publisher/src/run-publication.ts",
    "verify:local-stack": "node --experimental-transform-types tooling/verify-local-stack.mjs",
    "verify:publication-flow": "node --experimental-transform-types tooling/verify-publication-flow.ts",
    "verify:publisher-daemon": "node --experimental-transform-types tooling/verify-publisher-daemon.ts",
    "verify:publication-job-admission": "node tooling/verify-publication-job-admission.mjs",
    "verify:content-draft-lifecycle": "node tooling/verify-content-draft-lifecycle.mjs",
    "verify:production-compose": "node tooling/verify-production-compose.mjs",
    "verify:deploy-harness": "node tooling/verify-deploy-harness.mjs",
    "verify:backup-harness": "node tooling/verify-backup-harness.mjs",
    "verify:queue-runtime": "node --experimental-transform-types tooling/verify-queue-runtime.ts",
    "verify:ai-budget": "node --experimental-transform-types tooling/verify-ai-budget.ts",
    "verify:plan-quota": "node --experimental-transform-types tooling/verify-plan-quota.ts",
    "verify:caddy": "node tooling/verify-caddy.mjs",
    "verify:g30-observer": "node tooling/verify-g30-observer.mjs",
    "verify:alert-lifecycle": "node --experimental-transform-types tooling/verify-alert-lifecycle.ts",
    "verify:scheduler-runtime": "node --experimental-transform-types tooling/verify-scheduler-runtime.ts",
    "verify:worker-runtime": "node --experimental-transform-types tooling/verify-worker-runtime.ts",
    "verify:orap-operations": "node --experimental-transform-types tooling/verify-orap-operations.ts",
    "dev:api": "node --experimental-transform-types --env-file-if-exists=.env.local apps/api/src/main.ts",
    "scan:secrets": "node tooling/scan-secrets.mjs --scope full",
    "verify:goal": "node tooling/verify-goal.mjs",
    "verify:all": "node tooling/verify-goal.mjs --all"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prisma": "6.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
