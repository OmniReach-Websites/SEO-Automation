---
import Layout from '../layouts/Layout.astro';
import { process, services } from '../data/site';
---

<Layout title="OmniReach" description="OmniReach builds, launches, and manages dependable business websites with strong search foundations and ongoing support.">
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span></span>Websites, managed well</p>
        <h1>A better website.<br /><em>A dependable partner.</em></h1>
        <p class="hero-lede">OmniReach builds, launches, and looks after business websites—so your online presence stays useful, secure, and ready for the people trying to find you.</p>
        <div class="button-row">
          <a class="button" href="/contact/">Start a conversation</a>
          <a class="text-link" href="/services/">See what we do <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero-visual" aria-label="A website moving from strategy through launch and ongoing care">
        <div class="browser-card">
          <div class="browser-bar"><i></i><i></i><i></i><span>your business website</span></div>
          <div class="browser-content">
            <div class="mini-brand"></div>
            <div class="mini-nav"></div>
            <div class="mini-copy"><b></b><b></b><b></b></div>
            <div class="mini-button"></div>
          </div>
        </div>
        <div class="status-card status-one"><span>01</span><strong>Clear message</strong><small>Built around your business</small></div>
        <div class="status-card status-two"><span>02</span><strong>Live & secure</strong><small>Managed after launch</small></div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="OmniReach approach">
    <div class="shell trust-grid">
      <span>Custom-built</span><span>Mobile-ready</span><span>Search-friendly</span><span>Ongoing care</span>
    </div>
  </section>

  <section class="section" aria-labelledby="services-heading">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow"><span></span>What we do</p><h2 id="services-heading">From first draft to everyday operation.</h2></div>
        <p>We bring the creative and technical work under one roof, then stay involved after launch.</p>
      </div>
      <div class="service-grid">
        {services.map((service) => (
          <article class="service-card">
            <span>{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </article>
        ))}
      </div>
      <a class="text-link section-link" href="/services/">Explore our services <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section section-ink" aria-labelledby="difference-heading">
    <div class="shell difference-grid">
      <div>
        <p class="eyebrow light"><span></span>Why OmniReach</p>
        <h2 id="difference-heading">A website should not become another thing you have to manage.</h2>
      </div>
      <div class="difference-copy">
        <p>Many businesses get a website and are left alone with hosting, updates, broken details, and unclear next steps. We take a longer view.</p>
        <p>OmniReach combines focused design, careful development, and practical ongoing support. You get one team that understands how the site was built and what it is meant to accomplish.</p>
        <a class="text-link light-link" href="/about/">More about our approach <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section process-section" aria-labelledby="process-heading">
    <div class="shell">
      <div class="section-head compact">
        <div><p class="eyebrow"><span></span>How it works</p><h2 id="process-heading">Straightforward from start to finish.</h2></div>
      </div>
      <ol class="process-list">
        {process.map(([title, description], index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{description}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section cta-section">
    <div class="shell cta-panel">
      <div><p class="eyebrow light"><span></span>Ready when you are</p><h2>Let’s make your website easier to trust—and easier to manage.</h2></div>
      <a class="button button-light" href="/contact/">Tell us about your project</a>
    </div>
  </section>
</Layout>
