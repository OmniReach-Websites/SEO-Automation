---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://omnireach.cloud');
const pageTitle = title === 'OmniReach' ? title : `${title} | OmniReach`;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'OmniReach',
  url: 'https://omnireach.cloud/',
  description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5H7ZB5HMLC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      let analyticsConsent = 'denied';
      try {
        if (window.localStorage.getItem('omnireach_analytics_consent') === 'granted') {
          analyticsConsent = 'granted';
        }
      } catch {}
      gtag('consent', 'default', {
        analytics_storage: analyticsConsent,
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      gtag('js', new Date());

      gtag('config', 'G-5H7ZB5HMLC');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b1820" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/omnireach-logo.png" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OmniReach" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <aside class="analytics-consent" data-analytics-consent hidden aria-labelledby="analytics-consent-title">
      <div>
        <strong id="analytics-consent-title">Optional website analytics</strong>
        <p>Allow anonymous usage measurement to help us improve this website. Advertising storage stays disabled.</p>
      </div>
      <div class="analytics-consent-actions">
        <button class="button secondary" type="button" data-analytics-decline>Decline</button>
        <button class="button" type="button" data-analytics-accept>Allow analytics</button>
      </div>
    </aside>
    <script src="/analytics-consent.js" defer></script>
  </body>
</html>
