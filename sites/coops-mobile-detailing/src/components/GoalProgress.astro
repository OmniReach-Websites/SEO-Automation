---
interface Props {
  currentAmount?: number;
  target: number;
  visible: boolean;
}
const { currentAmount, target, visible } = Astro.props;
const canRender = visible && typeof currentAmount === 'number' && currentAmount >= 0 && target > 0;
const percentage = canRender ? Math.min(100, Math.round((currentAmount / target) * 100)) : 0;
---

{canRender && (
  <section class="goal-card" aria-labelledby="goal-heading">
    <p class="eyebrow">Cooper's first-car goal</p>
    <h2 id="goal-heading">Hard work with a destination</h2>
    <p>Cooper is building his detailing business while saving toward his first car.</p>
    <div class="goal-values"><strong>${currentAmount.toLocaleString()}</strong><span>of ${target.toLocaleString()}</span></div>
    <div class="goal-track" role="progressbar" aria-label="First-car savings progress" aria-valuemin="0" aria-valuemax={target} aria-valuenow={currentAmount}>
      <span style={`width:${percentage}%`}></span>
    </div>
    <p>{percentage}% of the goal</p>
  </section>
)}
