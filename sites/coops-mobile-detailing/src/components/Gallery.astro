---
import { galleryCategories, galleryItems } from '../data/site';
---

<div class="gallery" data-gallery>
  <div class="gallery-filters" aria-label="Filter work photos">
    {galleryCategories.map((category, index) => (
      <button type="button" class="filter-button" aria-pressed={index === 0 ? 'true' : 'false'} data-filter={category.id}>{category.label}</button>
    ))}
  </div>
  <div class="gallery-grid">
    {galleryItems.map((item, index) => (
      <button
        type="button"
        class:list={['gallery-card', `gallery-card-${(index % 5) + 1}`]}
        data-gallery-item
        data-category={item.category}
        data-image={item.image}
        data-alt={item.alt}
        data-title={item.title}
        data-caption={item.caption}
        aria-label={`Open ${item.title} photo`}
      >
        <img src={item.thumbnail} width="480" height="640" alt={item.alt} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
        <span class="gallery-card-overlay"><strong>{item.title}</strong><small>{item.caption}</small></span>
      </button>
    ))}
  </div>
  <dialog class="lightbox" aria-label="Work photo viewer" data-lightbox>
    <div class="lightbox-shell">
      <button class="lightbox-close" type="button" aria-label="Close photo viewer" data-lightbox-close>×</button>
      <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous photo" data-lightbox-prev>‹</button>
      <figure>
        <img src="/images/work-1.webp" alt="" width="756" height="1008" data-lightbox-image />
        <figcaption aria-live="polite"><strong data-lightbox-title></strong><span data-lightbox-caption></span></figcaption>
      </figure>
      <button class="lightbox-nav lightbox-next" type="button" aria-label="Next photo" data-lightbox-next>›</button>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll('[data-gallery]').forEach((gallery) => {
    const filterButtons = [...gallery.querySelectorAll('[data-filter]')];
    const allItems = [...gallery.querySelectorAll('[data-gallery-item]')];
    const dialog = gallery.querySelector('[data-lightbox]');
    const image = gallery.querySelector('[data-lightbox-image]');
    const title = gallery.querySelector('[data-lightbox-title]');
    const caption = gallery.querySelector('[data-lightbox-caption]');
    const close = gallery.querySelector('[data-lightbox-close]');
    const previous = gallery.querySelector('[data-lightbox-prev]');
    const next = gallery.querySelector('[data-lightbox-next]');
    let visibleItems = allItems;
    let activeIndex = 0;
    let opener: Element | null = null;

    if (!(dialog instanceof HTMLDialogElement) || !(image instanceof HTMLImageElement)) return;

    const showItem = (index: number) => {
      if (!visibleItems.length) return;
      activeIndex = (index + visibleItems.length) % visibleItems.length;
      const item = visibleItems[activeIndex];
      if (!(item instanceof HTMLElement)) return;
      image.src = item.dataset.image || '';
      image.alt = item.dataset.alt || '';
      if (title) title.textContent = item.dataset.title || '';
      if (caption) caption.textContent = item.dataset.caption || '';
    };

    filterButtons.forEach((button) => button.addEventListener('click', () => {
      if (!(button instanceof HTMLButtonElement)) return;
      const filter = button.dataset.filter;
      filterButtons.forEach((entry) => entry.setAttribute('aria-pressed', entry === button ? 'true' : 'false'));
      allItems.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        item.hidden = filter !== 'all' && item.dataset.category !== filter;
      });
      visibleItems = allItems.filter((item) => !(item instanceof HTMLElement) || !item.hidden);
    }));

    allItems.forEach((item) => item.addEventListener('click', () => {
      visibleItems = allItems.filter((entry) => !(entry instanceof HTMLElement) || !entry.hidden);
      activeIndex = visibleItems.indexOf(item);
      opener = item;
      showItem(activeIndex);
      dialog.showModal();
      document.body.classList.add('lightbox-open');
      if (close instanceof HTMLButtonElement) close.focus();
    }));

    close?.addEventListener('click', () => dialog.close());
    previous?.addEventListener('click', () => showItem(activeIndex - 1));
    next?.addEventListener('click', () => showItem(activeIndex + 1));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') showItem(activeIndex - 1);
      if (event.key === 'ArrowRight') showItem(activeIndex + 1);
    });
    dialog.addEventListener('close', () => {
      document.body.classList.remove('lightbox-open');
      if (opener instanceof HTMLElement) opener.focus();
    });
  });
</script>
