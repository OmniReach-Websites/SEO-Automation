---
import Layout from '../layouts/Layout.astro';
import { metadataFor, privacyContent } from '../data/site';
const metadata = metadataFor('privacy');
---

<Layout
  title={metadata.title}
  description={metadata.description}
  image={metadata.image}
>
  <section class="legal-page section-light">
    <article class="legal-content shell">
      <p class="eyebrow">Website privacy</p>
      <h1>Privacy notice</h1>
      <div set:html={privacyContent}></div>
    </article>
  </section>
</Layout>
