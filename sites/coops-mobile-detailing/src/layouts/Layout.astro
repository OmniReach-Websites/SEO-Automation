---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileActions from '../components/MobileActions.astro';
import { SITE_URL, siteTheme } from '../data/site';

interface Props {
  canonicalPath?: string;
  description: string;
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  title: string;
}

const {
  canonicalPath = Astro.url.pathname,
  description,
  image = '/images/social-card.webp',
  noindex = false,
  structuredData,
  title,
} = Astro.props;
const canonical = new URL(canonicalPath, SITE_URL).toString();
const socialImage = new URL(image, SITE_URL).toString();
const documentTitle = `${title} | Coop's Mobile Detailing`;
const serializedSchema = structuredData
  ? JSON.stringify(structuredData).replaceAll('<', '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="en-US">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-B6S8N9JHL8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      let analyticsConsent = 'denied';
      try {
        if (window.localStorage.getItem('coops_analytics_consent') === 'granted') {
          analyticsConsent = 'granted';
        }
      } catch {}
      gtag('consent', 'default', {
        analytics_storage: analyticsConsent,
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      gtag('js', new Date());

      gtag('config', 'G-B6S8N9JHL8');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e141b" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coop's Mobile Detailing" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Coop's Mobile Detailing logo beside a detailed vehicle" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{documentTitle}</title>
    {serializedSchema && <script type="application/ld+json" set:html={serializedSchema} />}
  </head>
  <body data-theme={siteTheme}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <MobileActions />
    <aside class="analytics-consent" data-analytics-consent hidden aria-labelledby="analytics-consent-title">
      <div>
        <strong id="analytics-consent-title">Optional website analytics</strong>
        <p>Allow anonymous usage measurement to help improve this website. Advertising storage stays disabled.</p>
      </div>
      <div class="analytics-consent-actions">
        <button class="button button-secondary" type="button" data-analytics-decline>Decline</button>
        <button class="button button-primary" type="button" data-analytics-accept>Allow analytics</button>
      </div>
    </aside>
    <script src="/analytics-consent.js" defer></script>
  </body>
</html>
